# Copy this file to .env and adjust the values, then restart `npm run dev`.

# Email address shown in the contact section and used for the mailto fallback.
VITE_CONTACT_EMAIL=abhijithm730@gmail.com

# Phone number shown in the contact section (10 digits, +91 is added).
# Leave it empty (VITE_CONTACT_PHONE=) to hide the phone number.
VITE_CONTACT_PHONE=8139839416

# Where the contact form posts messages. If this line is left out, the form uses
# FormSubmit (https://formsubmit.co/ajax/<VITE_CONTACT_EMAIL>), which emails each
# message to the address above. You can use another JSON endpoint instead, such as
# a Formspree URL. Set it to an empty value (VITE_FORM_ENDPOINT=) to have the form
# open the visitor's email app with a prefilled message instead.
# VITE_FORM_ENDPOINT=https://formsubmit.co/ajax/abhijithm730@gmail.com
